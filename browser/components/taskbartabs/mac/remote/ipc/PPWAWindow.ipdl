// using mozilla::LayoutDeviceIntRect from "Units.h";

include protocol PPWA;

namespace mozilla {
namespace pwa {

// Top-level actor that represents the Demo process type in the content process.
// The content process will be the Parent and the Demo process will be the Child.
[ChildProc=PWA]
async protocol PPWAWindow {
child:
  async SetTitle(nsString title);

  async __delete__();
};

} // namespace pwa
} // namespace mozilla
