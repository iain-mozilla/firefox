EXPORTS += [
    "action.h",
    "removedir.h",
    "removefile.h",
]

SOURCES += [
    "actionhelpers.cpp",
    "removedir.cpp",
    "removefile.cpp",
]

Library("actions")

DEFINES["NS_NO_XPCOM"] = True
USE_STATIC_MSVCRT = True

DisableStlWrapping()
